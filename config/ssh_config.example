    ControlMaster auto
    ControlPath ~/.ssh/sockets/lan-%C
    ControlPersist 600

# 利用者用：学内の別ネットワーク・学外・自宅・テザリングからのSSM経由接続
# GPUへ直接到達できなくても、AWSの認証・SSMエンドポイントへの通信が
# 許可されていれば使用できる。事前にaws sso login --profile __AWS_PROFILE__を実行する。
# quadra-ssmがSession Managerの入口で、GPUサーバーはProxyJumpで経由する。
Host quadra-ssm
    HostName __QUADRA_MANAGED_NODE_ID__
    User __SSH_USER__
    IdentityFile __IDENTITY_FILE__
    IdentitiesOnly yes
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --region __AWS_REGION__ --profile __AWS_PROFILE__"
    # Windows標準OpenSSHでは上のProxyCommandを削除し、次の行の先頭の#を外す。
    # ProxyCommand aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p --region __AWS_REGION__ --profile __AWS_PROFILE__

Host rtx-a6000x2-ssm
    HostName 192.168.73.83
    User __SSH_USER__
    IdentityFile __IDENTITY_FILE__
    IdentitiesOnly yes
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ProxyJump quadra-ssm
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 600

# AIsawa（RTX 6000 Ada搭載機）。2つ目は旧aliasとの互換用。
