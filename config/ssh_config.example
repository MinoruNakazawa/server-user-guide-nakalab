    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/sockets/lan-%C
    ControlPersist 600

Host rtx5090-lan
    HostName 192.168.73.163
    User __SSH_USER__
    IdentityFile __IDENTITY_FILE__
